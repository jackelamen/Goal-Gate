<?xml version="1.0" encoding="utf-8"?>
<!--
    The home-screen widget (see ui/GoalGateWidget.kt).
    Today's goal, in the user's own words, and a "Check in" button that opens
    the Goals tab. Dawn-sky background, white text, the summit mark at the top.
    Widgets only allow certain view types (LinearLayout, FrameLayout,
    TextView, ImageView), so nothing else is used here.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="15dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_mark" />

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/figtree"
            android:letterSpacing="0.1"
            android:text="@string/widget_today"
            android:textAllCaps="true"
            android:textColor="#BFFFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_goal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/bricolage_grotesque"
        android:maxLines="3"
        android:textColor="#FFFFFFFF"
        android:textSize="21sp" />

    <!-- The goal's next step, if it has one. Hidden otherwise. -->
    <TextView
        android:id="@+id/widget_next_step"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/figtree"
        android:maxLines="1"
        android:textColor="#BFFFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_check_in"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_button"
        android:fontFamily="@font/figtree"
        android:minHeight="36dp"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/widget_check_in"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
